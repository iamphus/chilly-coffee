{
  "name": "chilly-coffee",
  "version": "0.1.0",
  "private": true,
  "description": "Chilly Coffee: quán cafe 3D để học và làm việc",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "serve": "npx http-server -p 8765 -c-1 .",
    "prototype": "npm run build:pack && npm run serve",
    "build:cafe": "node tools/export-cafe/run.js \"[]\" assets/cafe/cafe.glb",
    "build:nav": "python tools/build_nav.py",
    "build:pack": "python tools/pack_model.py",
    "build:chars": "node tools/export-characters/run.js export",
    "build:video": "node tools/render-video/run.js",
    "screenshot": "node tools/screenshot.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.14.0",
    "playwright": "^1.48.0",
    "three149": "npm:three@0.149.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "i18next": "^27.1.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "^18.0.1",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "zustand": "^5.1.0"
  }
}
